# Turso (libSQL) database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth.js v5
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# CSV of Google emails allowed to sign in (no spaces)
ALLOWED_EMAILS=

# Used by scripts/seed.ts as the seed user
OWNER_EMAIL=

# Bearer token for /api/cron/scan
CRON_SECRET=

# Data provider — only "yahoo" is supported in v1
DATA_PROVIDER=yahoo

# Hero "nothing notable" threshold (default 25.0)
HERO_THRESHOLD=25.0
